<!-- RuleEditorWindow.xaml -->
<Window x:Class="RedirectProxyGui.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rule Editor" Height="650" Width="600" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Basic Settings -->
                <GroupBox Header="Basic Settings" Margin="0,0,0,10">
                    <StackPanel Margin="8">
                        <TextBlock Text="Match (URL prefix to intercept)" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtMatch" Margin="0,4,0,8"/>

                        <TextBlock Text="To (Target URL prefix)" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtTo" Margin="0,4,0,8"/>

                        <TextBlock Text="API Key (optional)" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtApiKey" Margin="0,4,0,8"/>

                        <CheckBox x:Name="ChkEnabled" Content="Enabled" IsChecked="True"/>
                    </StackPanel>
                </GroupBox>

                <!-- Custom Headers -->
                <GroupBox Header="Custom Headers" Margin="0,0,0,10">
                    <StackPanel Margin="8">
                        <DataGrid x:Name="HeadersGrid" Height="120" AutoGenerateColumns="False"
                                  CanUserAddRows="True" CanUserDeleteRows="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Header Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Add custom headers to override/inject (e.g., Cookie, Authorization, X-Custom-Header)"
                                   FontSize="10" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <!-- Login Configuration -->
                <GroupBox Header="Login Configuration (Optional)" Margin="0,0,0,10">
                    <StackPanel Margin="8">
                        <TextBlock Text="Login URL" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtLoginUrl" Margin="0,4,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Method" FontWeight="SemiBold"/>
                                <ComboBox x:Name="CmbLoginMethod" Margin="0,4,0,8" SelectedIndex="0">
                                    <ComboBoxItem Content="POST"/>
                                    <ComboBoxItem Content="GET"/>
                                    <ComboBoxItem Content="PUT"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Content-Type" FontWeight="SemiBold"/>
                                <ComboBox x:Name="CmbContentType" Margin="0,4,0,8" SelectedIndex="0" IsEditable="True">
                                    <ComboBoxItem Content="application/json"/>
                                    <ComboBoxItem Content="application/x-www-form-urlencoded"/>
                                    <ComboBoxItem Content="multipart/form-data"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Request Body" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtLoginBody" Height="60" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8"/>

                        <TextBlock Text="Login Headers" FontWeight="SemiBold"/>
                        <DataGrid x:Name="LoginHeadersGrid" Height="100" AutoGenerateColumns="False"
                                  CanUserAddRows="True" CanUserDeleteRows="True" Margin="0,4,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Header Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Cookie Pairs (Manual Cookies)" FontWeight="SemiBold"/>
                        <DataGrid x:Name="CookiePairsGrid" Height="100" AutoGenerateColumns="False"
                                  CanUserAddRows="True" CanUserDeleteRows="True" Margin="0,4,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                                <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="*"/>
                                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="Save" Width="100" Margin="0,0,8,0"/>
            <Button x:Name="BtnCancel" Content="Cancel" Width="100"/>
        </StackPanel>
    </Grid>
</Window>
