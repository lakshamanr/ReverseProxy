<!-- MainWindow.xaml -->
<Window x:Class="RedirectProxyGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Redirect Proxy GUI" Height="700" Width="1100">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Rules -->
        <StackPanel Grid.Column="0" Margin="10" >
            <TextBlock Text="Rules" FontWeight="Bold" FontSize="16"/>
            <ListBox x:Name="RulesList" Height="380" Margin="0,8,0,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Match}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding To}" FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Proxy Controls -->
            <WrapPanel Margin="0,0,0,8" HorizontalAlignment="Left">
                <Button x:Name="BtnStart" Content="Start Proxy" Width="100" Margin="0,0,8,0"/>
                <Button x:Name="BtnStop" Content="Stop Proxy" Width="100" Margin="0,0,8,0" IsEnabled="False"/>
                <Button x:Name="BtnReload" Content="Reload" Width="80"/>
            </WrapPanel>

            <!-- Rule Management -->
            <GroupBox Header="Rule Management" Margin="0,0,0,8">
                <StackPanel Margin="8">
                    <Button x:Name="BtnAddRule" Content="Add New Rule" Margin="0,0,0,6"/>
                    <Button x:Name="BtnEditRule" Content="Edit Selected Rule" Margin="0,0,0,6"/>
                    <Button x:Name="BtnDeleteRule" Content="Delete Selected Rule" Margin="0,0,0,6"/>
                    <Button x:Name="BtnPerformLogin" Content="Perform Login for Selected" Margin="0,0,0,0"/>
                </StackPanel>
            </GroupBox>

            <TextBlock Text="Notes: set browser proxy to http://localhost:8000" Margin="0,0,0,4" TextWrapping="Wrap" FontSize="11"/>
            <TextBlock Text="Rules are auto-saved to rules.json and auto-reloaded" FontStyle="Italic" FontSize="10" Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Right: Logs -->
        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Live Intercept Log" FontWeight="Bold" FontSize="16"/>
            <ListBox x:Name="LogList" Margin="0,8,0,8" Height="520">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,0,8" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="{Binding Timestamp}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding OriginalUrl}" TextWrapping="Wrap"/>
                                <TextBlock Text="→ Redirected to:" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding RedirectUrl}" TextWrapping="Wrap"/>
                                <Expander Header="Incoming Headers" IsExpanded="False" Margin="0,6,0,0">
                                    <ItemsControl ItemsSource="{Binding IncomingHeaders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontFamily="Consolas" FontSize="12">
                                                    <Run Text="{Binding Key}"/><Run Text=" : "/><Run Text="{Binding Value}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                                <Expander Header="Outgoing Headers" IsExpanded="False" Margin="0,6,0,0">
                                    <ItemsControl ItemsSource="{Binding OutgoingHeaders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontFamily="Consolas" FontSize="12">
                                                    <Run Text="{Binding Key}"/><Run Text=" : "/><Run Text="{Binding Value}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Window>
